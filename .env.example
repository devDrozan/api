PORT=3001
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
TRUSTED_PROXIES=

# Legacy Korean reference endpoints use the following configuration.
# Mobile CBM Official Rate uses separate /cbm endpoints and fixed public sources.
# auto (default): KB Kookmin Bank -> licensed feed when configured -> KMB.
# kb | kmb | hana pin one source; none disables official conversion.
# Hundi conversion keeps working because it uses only user-entered rates.
EXCHANGE_RATE_PROVIDER=auto

# Optional licensed normalized feed for Hana/IBK Open API access. Enable only
# after approved Korean-source access and an operator-owned adapter exist.
EXCHANGE_RATE_ACCESS_APPROVED=false
EXCHANGE_RATE_FEED_PROVIDER=hana
EXCHANGE_RATE_FEED_URL=
EXCHANGE_RATE_FEED_TOKEN=

# Optional public mobile presentation settings, JSON <=32 KiB. No secrets.
# See config/mobile-config.example.json and README. Empty uses bundled defaults.
REMOTE_CONFIG_JSON=

# Existing Supabase project. Secret key stays on this server only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Separate gates: neither is enabled until explicitly configured.
ADMIN_ENABLED=false
ADMIN_PUBLIC_CONTENT_ENABLED=false
# For local admin development add http://127.0.0.1:5174 to ALLOWED_ORIGINS.
